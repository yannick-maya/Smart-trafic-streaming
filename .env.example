# Runtime image versions
KAFKA_IMAGE=apache/kafka:4.4.0
NIFI_IMAGE=apache/nifi:2.7.2
MINIO_IMAGE=dappros/minio:RELEASE.2025-09-07T16-13-09Z
POSTGIS_IMAGE=postgis/postgis:17-3.7
GRAFANA_IMAGE=grafana/grafana:12.4.15
KAFKA_UI_IMAGE=kafbat/kafka-ui:v1.5.0

# Published host ports
KAFKA_PORT=9092
NIFI_HTTPS_PORT=8443
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_PORT=5433
GRAFANA_PORT=3000
KAFKA_UI_PORT=8080

# Local development credentials only; change these for any shared environment.
NIFI_USERNAME=admin
NIFI_PASSWORD=local-nifi-password-change-me
MINIO_ROOT_USER=localminio
MINIO_ROOT_PASSWORD=local-minio-password-change-me
POSTGRES_DB=traffic
POSTGRES_USER=traffic
POSTGRES_PASSWORD=local-postgres-password-change-me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana-password-change-me

# Storage and Kafka defaults for a single-node local demonstration.
MINIO_RAW_BUCKET=traffic-raw
MINIO_QUARANTINE_BUCKET=traffic-quarantine
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_RETENTION_MS=604800000
