{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yannick-maya.github.io/smart-traffic/schemas/traffic.sensor.flow.schema.json",
  "title": "Mesure de débit par capteur et fenêtre de cinq minutes",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "observed_at", "sensor_id", "troncon_id", "vehicle_count_5min", "two_wheeler_share", "data_origin"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid", "description": "Identifiant stable du message."},
    "observed_at": {"type": "string", "format": "date-time", "description": "Fin de la fenêtre en UTC, ISO 8601."},
    "sensor_id": {"type": "string", "minLength": 1},
    "troncon_id": {"type": "string", "minLength": 1},
    "vehicle_count_5min": {"type": "integer", "minimum": 0, "description": "Nombre de véhicules observés/simulés en cinq minutes."},
    "two_wheeler_share": {"type": "number", "minimum": 0, "maximum": 1, "description": "Part des deux-roues, ratio entre 0 et 1."},
    "data_origin": {"const": "simulated", "description": "Le trafic de Lomé est simulé."}
  },
  "examples": [{"event_id": "2b668c48-8984-4e61-b70d-77329510383b", "observed_at": "2026-11-20T07:05:00Z", "sensor_id": "sensor-54570849-1", "troncon_id": "osm-way-54570849", "vehicle_count_5min": 146, "two_wheeler_share": 0.72, "data_origin": "simulated"}]
}
